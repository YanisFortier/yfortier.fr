---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Section from '../components/Section.astro';
import Job from '../components/Job.astro';
import FormationItem from '../components/FormationItem.astro';
import Stack from '../components/Stack.astro';
import { rich } from '../lib/rich';

import { profil } from '../data/profil';
import { experiences } from '../data/experiences';
import { formations } from '../data/formations';
import { competences, langues } from '../data/competences';
import { introEngagements, engagements, valeurs } from '../data/engagements';
import { certifications, prix } from '../data/distinctions';

const sections = [
  { id: 'accueil', label: 'Accueil' },
  { id: 'experiences', label: 'Expériences' },
  { id: 'formations', label: 'Formations' },
  { id: 'competences', label: 'Compétences' },
  { id: 'engagements', label: 'Engagements' },
  { id: 'distinctions', label: 'Prix & certifications' },
];

const download = '<path d="M8 2v8m0 0 3-3m-3 3L5 7M3 13h10"/>';
---

<Base>
  <Sidebar sections={sections} />

  <main id="contenu" tabindex="-1">
    <!-- Accueil -->
    <section class="section hero" id="accueil" aria-labelledby="titre-accueil">
      <span class="eyebrow">{profil.title}</span>
      <h1 class="hero__title" id="titre-accueil">{profil.firstName} <span>{profil.lastName}</span></h1>
      <p class="hero__lead">{profil.lead}</p>

      <dl class="facts">
        {
          profil.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="actions">
        <a class="btn btn--primary" href={profil.cv.fr}>
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" set:html={download} />
          CV en français <span class="visually-hidden">(PDF)</span>
        </a>
        <a class="btn" href={profil.cv.en} lang="en">
          <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" set:html={download} />
          Resume in English <span class="visually-hidden">(PDF)</span>
        </a>
        <a class="btn" href={`mailto:${profil.email}`}>Me contacter</a>
      </div>
    </section>

    <Section id="experiences" eyebrow="Parcours" title="Expériences">
      <ol class="timeline">
        {experiences.map((job) => <Job job={job} />)}
      </ol>
    </Section>

    <Section id="formations" eyebrow="Études" title="Formations">
      <ol class="timeline">
        {formations.map((f) => <FormationItem formation={f} />)}
      </ol>
    </Section>

    <Section id="competences" eyebrow="Savoir-faire" title="Compétences">
      <div class="skills">
        {
          competences.map((g, i) => (
            <div class:list={['skill-group', { 'skill-group--wide': i === 0 }]}>
              <h3 class="group__title">{g.title}</h3>
              <Stack items={g.items} label={g.title} />
            </div>
          ))
        }
        <div class="skill-group">
          <h3 class="group__title">Langues</h3>
          <ul class="langs">
            {
              langues.map((l) => (
                <li>
                  <span>
                    <span aria-hidden="true">{l.flag}</span> {l.name}
                  </span>
                  <span class="lvl">{l.level}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Section>

    <Section id="engagements" eyebrow="Au-delà du travail" title="Engagements">
      <p class="intro">{introEngagements}</p>

      <div class="engagements">
        {
          engagements.map((e) => (
            <article class="engagement">
              <h3 class="engagement__title">{e.title}</h3>
              <div>
                {e.body.map((p) => (
                  <p set:html={rich(p)} />
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <div class="values">
        <h3 class="values__title">Mes valeurs</h3>
        <p set:html={rich(valeurs.texte)} />
        <div class="values__lists">
          <div class="v-plus">
            <h4>Valeurs</h4>
            <ul>{valeurs.valeurs.map((v) => <li>{v}</li>)}</ul>
          </div>
          <div class="v-minus">
            <h4>Anti-valeurs</h4>
            <ul>{valeurs.antiValeurs.map((v) => <li>{v}</li>)}</ul>
          </div>
        </div>
      </div>
    </Section>

    <Section id="distinctions" eyebrow="Reconnaissance" title="Prix & certifications">
      <div class="awards">
        <div>
          <h3>Certifications & formations</h3>
          <ul>{certifications.map((c) => <li set:html={rich(c)} />)}</ul>
        </div>
        <div>
          <h3>Prix</h3>
          <ul>
            {
              prix.map((p) => (
                <li class="prize">
                  <span>{p.event}</span>
                  <span class="prize__rank">{p.rank}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Section>

    <footer class="footer">
      © {new Date().getFullYear()} {profil.firstName} {profil.lastName} · <a href={profil.linkedin}>LinkedIn</a> · <a href={profil.github}>GitHub</a>
    </footer>
  </main>
</Base>
