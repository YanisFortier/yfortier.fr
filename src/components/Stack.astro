---
import { tr, type Locale, type Tr } from '../i18n/ui';

interface Props {
  items: Tr<string>[] | readonly string[];
  locale: Locale;
  label: string;
}

const { items, locale, label } = Astro.props;
---

<ul class="stack" aria-label={label}>
  {items.map((item) => <li>{tr(item, locale)}</li>)}
</ul>
