---
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
---

<!--
  Bouton bascule clair/sombre. aria-pressed="true" = thème sombre actif.
  L'état initial est posé par le script en ligne de Base.astro (avant affichage).
-->
<button class:list={['theme-toggle', className]} type="button" aria-pressed="false" title={ui[locale].theme}>
  <span class="visually-hidden">{ui[locale].theme}</span>
  <!-- Lune : affichée en thème clair -->
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z"></path>
  </svg>
  <!-- Soleil : affiché en thème sombre -->
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
</button>
