---
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/400-italic.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/public-sans/800.css';
import '../styles/global.css';
import { profil } from '../data/profil';
import { languages, locales, defaultLocale, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const lang = languages[locale];
const title = `${profil.firstName} ${profil.lastName} — ${profil.title[locale]}`;
const description = profil.description[locale];

const canonical = new URL(lang.path, Astro.site);
const ogImage = new URL('/img/og_image.jpg', Astro.site);
---

<!doctype html>
<html lang={lang.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${profil.firstName} ${profil.lastName}`} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={languages[l].htmlLang} href={new URL(languages[l].path, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(languages[defaultLocale].path, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#1b3266" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={lang.ogLocale} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{ui[locale].skip}</a>
    <slot />
  </body>
</html>
