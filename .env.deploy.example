# Copier ce fichier en .env.deploy (il n'est pas versionné) puis le remplir.
# Infos dans l'admin alwaysdata : Accès distant > SSH.

# Nom du compte alwaysdata (ex. yfortier)
DEPLOY_USER=moncompte
# Serveur SSH : ssh-<compte>.alwaysdata.net
DEPLOY_HOST=ssh-moncompte.alwaysdata.net
# Dossier servi par le site (Web > Sites > yfortier.fr > « Répertoire racine »)
DEPLOY_PATH=/home/moncompte/www/
